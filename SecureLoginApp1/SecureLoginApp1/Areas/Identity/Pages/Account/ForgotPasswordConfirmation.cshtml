@page
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="form-card text-center">
    <h1>Check your inbox</h1>
    <p class="subtitle">If an account with that email exists, we've sent a link to reset your password.</p>
    <a class="btn btn-outline-primary" asp-area="Identity" asp-page="/Account/Login">Back to login</a>
</div>
