@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Set up authenticator app";
}

<h1>Set up authenticator app</h1>

<p>Scan the QR code below with your authenticator app (Google Authenticator, Microsoft Authenticator, etc.), or enter the key manually.</p>

<div id="qrCode"></div>
<div id="qrCodeData" data-uri="@Html.Raw(Model.AuthenticatorUri)"></div>

<p class="mt-3">Or enter this key manually: <code>@Model.SharedKey</code></p>

<form method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Input.Code"></label>
        <input asp-for="Input.Code" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Verify and enable</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/qrcodejs/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById("qrCode"), {
            text: document.getElementById("qrCodeData").getAttribute("data-uri"),
            width: 200,
            height: 200
        });
    </script>
}
