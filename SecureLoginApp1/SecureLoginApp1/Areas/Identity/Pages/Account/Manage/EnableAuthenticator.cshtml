@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Set up authenticator app";
}

<div class="form-card form-card--wide">
    <h1>Set up authenticator app</h1>
    <p class="subtitle">Scan the QR code below with your authenticator app (Google Authenticator, Microsoft Authenticator, etc.), or enter the key manually.</p>

    <div class="text-center mb-3">
        <div id="qrCode"></div>
        <div id="qrCodeData" data-uri="@Html.Raw(Model.AuthenticatorUri)"></div>
    </div>

    <p class="text-center">Or enter this key manually: <code>@Model.SharedKey</code></p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group mb-3">
            <label asp-for="Input.Code"></label>
            <input asp-for="Input.Code" class="form-control" autocomplete="off" />
            <span asp-validation-for="Input.Code" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Verify and enable</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/qrcodejs/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById("qrCode"), {
            text: document.getElementById("qrCodeData").getAttribute("data-uri"),
            width: 200,
            height: 200
        });
    </script>
}
