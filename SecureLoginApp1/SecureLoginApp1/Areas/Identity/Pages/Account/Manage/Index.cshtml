@page
@model IndexModel
@{
    ViewData["Title"] = "Manage your account";
}

<div class="form-card">
    <h1>Manage your account</h1>

    <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
    <p class="mb-4"><strong>User name:</strong> @Model.UserName</p>

    <a asp-page="/Account/Manage/ChangePassword" asp-area="Identity" class="btn btn-outline-primary w-100">Change your password</a>
</div>
