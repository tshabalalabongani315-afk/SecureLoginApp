@page
@model SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<div class="mt-4 mb-4">
    <h1 class="h3 mb-1">Account Settings</h1>
    <p class="text-muted mb-0">Manage your profile, password, and account security.</p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <a class="settings-link-card" asp-page="/Profile">
            <h3>Profile</h3>
            <p>Update your name, phone number, and profile photo.</p>
        </a>
    </div>
    <div class="col-md-4">
        <a class="settings-link-card" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
            <h3>Password</h3>
            <p>Change the password used to sign in.</p>
        </a>
    </div>
    <div class="col-md-4">
        <a class="settings-link-card" asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication">
            <h3>Two-Factor Authentication</h3>
            <p>Add or remove an authenticator app for extra security.</p>
        </a>
    </div>
</div>
