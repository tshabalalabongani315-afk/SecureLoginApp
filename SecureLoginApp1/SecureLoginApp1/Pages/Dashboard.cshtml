@page
@model SecureLoginApp1.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">
    @if (!Model.EmailConfirmed)
    {
        <div class="row mb-3">
            <div class="col-12">
                <div class="alert alert-warning d-flex justify-content-between align-items-center" role="alert">
                    <span>Your email address is not verified yet. Please check your inbox for the confirmation link.</span>
                    <form method="post" asp-page-handler="ResendConfirmation" class="mb-0">
                        <button type="submit" class="btn btn-sm btn-outline-dark">Resend confirmation email</button>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="row mb-3">
        <div class="col-12">
            <h1 class="h3">Welcome, @Model.FirstName</h1>
            <p class="text-muted">Current server time (UTC): @Model.ServerDateTime.ToString("u")</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4 mb-3">
            <div class="card">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl" alt="Profile" class="rounded-circle" style="width:120px;height:120px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center" style="width:120px;height:120px;font-size:36px;">
                            @Model.Initials
                        </div>
                    }

                    <h5 class="mt-3">@Model.FullName</h5>
                    <p class="text-muted">
                        @Model.Email
                        @if (Model.EmailConfirmed)
                        {
                            <span class="badge bg-success">Verified</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Unverified</span>
                        }
                    </p>
                    <p class="mb-0"><strong>Phone:</strong> @(!string.IsNullOrEmpty(Model.PhoneNumber) ? Model.PhoneNumber : "Not provided")</p>
                    <p class="mb-0"><strong>Member since:</strong> @Model.CreatedDate.ToString("g")</p>
                    <p class="mb-0"><strong>Last login:</strong> @(Model.LastLogin.HasValue ? Model.LastLogin.Value.ToString("g") : "Never")</p>
                </div>
            </div>
        </div>

        <div class="col-lg-8 mb-3">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h6 class="card-title">My Profile</h6>
                            <p class="card-text">View and update your profile information.</p>
                            <a class="btn btn-primary" asp-page="/Profile">View Profile</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h6 class="card-title">Security</h6>
                            <p class="card-text">Change your password or manage account security settings.</p>
                            <a class="btn btn-outline-primary" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">Change Password</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h6 class="card-title">Settings</h6>
                            <p class="card-text">Account settings and preferences (coming soon).</p>
                            <a class="btn btn-outline-secondary" asp-page="/Index">Settings (placeholder)</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h6 class="card-title">Activity</h6>
                            <ul class="list-unstyled">
                                @foreach (var act in Model.Activity)
                                {
                                    <li>
                                        <strong>@act.Title</strong>
                                        <div class="text-muted small">@((act.Timestamp.HasValue) ? act.Timestamp.Value.ToString("g") : act.Details)</div>
                                    </li>
                                    <hr />
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-3 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Days as Member</h5>
                    <p class="display-6">@Model.DaysAsMember</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Total Successful Logins</h5>
                    <p class="display-6">@Model.TotalSuccessfulLogins</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Account Status</h5>
                    <p class="display-6">@Model.AccountStatus</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Authentication</h5>
                    <p class="display-6">@Model.AuthenticationMethod</p>
                </div>
            </div>
        </div>
    </div>
</div>
