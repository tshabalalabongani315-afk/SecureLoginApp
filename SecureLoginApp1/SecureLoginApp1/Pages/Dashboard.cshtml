@page
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

@if (!Model.EmailConfirmed)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center mt-4" role="alert">
        <span>Your email address is not verified yet. Please check your inbox for the confirmation link.</span>
        <form method="post" asp-page-handler="ResendConfirmation" class="mb-0">
            <button type="submit" class="btn btn-sm btn-outline-dark">Resend confirmation email</button>
        </form>
    </div>
}

<div class="mt-4 mb-4">
    <h1 class="h3 mb-1">Welcome, @Model.FirstName</h1>
    <p class="text-muted mb-0">Current server time (UTC): @Model.ServerDateTime.ToString("u")</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card__label">Member Since</div>
            <div class="stat-card__value">@Model.CreatedDate.ToString("MMM d, yyyy")</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card__label">Last Login</div>
            <div class="stat-card__value">@(Model.LastLogin.HasValue ? Model.LastLogin.Value.ToString("MMM d, h:mm tt") : "Never")</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card__label">Verified Status</div>
            <div class="stat-card__value">
                @if (Model.EmailConfirmed)
                {
                    <span class="badge bg-success">Verified</span>
                }
                else
                {
                    <span class="badge bg-secondary">Unverified</span>
                }
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card__label">2FA Status</div>
            <div class="stat-card__value">
                @if (Model.TwoFactorEnabled)
                {
                    <span class="badge bg-success">Enabled</span>
                }
                else
                {
                    <span class="badge bg-secondary">Not enabled</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                {
                    <img src="@Model.ProfileImageUrl" alt="Profile" class="rounded-circle" style="width:110px;height:110px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width:110px;height:110px;font-size:32px;background-color:var(--accent-soft);color:var(--accent);">
                        @Model.Initials
                    </div>
                }

                <h5 class="mt-3 mb-0">@Model.FullName</h5>
                <p class="text-muted mb-2">@Model.Email</p>
                <p class="mb-3"><strong>Phone:</strong> @(!string.IsNullOrEmpty(Model.PhoneNumber) ? Model.PhoneNumber : "Not provided")</p>

                <div class="d-grid gap-2">
                    <a class="btn btn-primary btn-sm" asp-page="/Profile">View Profile</a>
                    <a class="btn btn-outline-primary btn-sm" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">Change Password</a>
                    <a class="btn btn-outline-primary btn-sm" asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication">Two-Factor Auth</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title mb-3">Recent Activity</h6>
                <ul class="activity-timeline">
                    @foreach (var act in Model.Activity)
                    {
                        <li>
                            <strong>@act.Title</strong>
                            <div class="text-muted small">@((act.TimestampUtc.HasValue) ? act.TimestampUtc.Value.ToString("g") : act.Details)</div>
                        </li>
                    }
                </ul>
            </div>
        </div>
<h1>Dashboard</h1>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Welcome, @Model.FullName</h5>
        <p class="card-text"><strong>Email:</strong> @Model.Email</p>
        <p class="card-text"><strong>Account created:</strong> @Model.CreatedDate.ToString("g")</p>
        <p class="card-text"><strong>Last login:</strong> @(Model.LastLogin.HasValue ? Model.LastLogin.Value.ToString("g") : "Never")</p>
    </div>
</div>
